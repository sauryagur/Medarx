{
  "name": "@medarx/viewer",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Medarx OHIF extension panel: design tokens, the panel shell and the privacy-details container.",
  "scripts": {
    "tokens": "bun run design/build.ts",
    "check:generated": "git diff --exit-code -- design/tokens.css design/tokens.ts",
    "lint": "eslint .",
    "test": "bun test design",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "dev": "vite",
    "build": "bun run tokens && tsc -p tsconfig.json --noEmit && vite build",
    "verify": "bun run tokens && bun run lint && bun test design && bun run typecheck && bun run check:generated"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@ohif/core": "3.13.10",
    "@types/bun": "^1.4.2",
    "@types/node": "24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6"
  }
}
